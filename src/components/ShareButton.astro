---
/**
 * Botón flotante "Share" y contenedor de share-wrapper.
 * Los iconos los inyecta src/scripts/global.ts (sin el plugin jQuery .share()).
 */
---

<div class="share-btn showshare color-bg">
  <span>Share <i class="fal fa-plus"></i></span>
</div>

<div class="share-wrapper">
  <div class="close-share-btn"><i class="fal fa-long-arrow-left"></i></div>
  <div class="share-container fl-wrap isShare"></div>
</div>
