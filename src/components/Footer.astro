---
/**
 * "Footer" del sitio. El template original no tiene un <footer> visual;
 * este componente agrupa el cursor personalizado y las decoraciones que en el
 * HTML original vivían al final del <div id="main">. Se mantiene aparte para
 * poder añadir en el futuro un footer semántico (créditos, links legales, etc.)
 * sin tocar el BaseLayout.
 */
---

<!-- cursor personalizado -->
<div class="element">
  <div class="element-item"></div>
</div>
<!-- cursor end -->
