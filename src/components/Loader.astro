---
/**
 * Loader inicial del template (animación al cargar la página).
 * Estructura tomada 1:1 del sitio original para preservar el
 * comportamiento de css/style.css + js/scripts.js.
 */
---

<div class="loader">
  <div class="loading-text-container">
    <span class="loading-text">Load<strong>ing</strong></span>
    <span class="loader_count">0</span>
  </div>
  <div class="loader-anim"></div>
  <div class="loader-anim2 color-bg"></div>
</div>
