---
/**
 * Indicador de "scroll down" que aparece en varias páginas (home, portfolio,
 * portfolio-single). Reproduce el bloque `<div class="hero-scroll-down-notifer">`
 * del template original.
 */
---

<div class="hero-scroll-down-notifer">
  <div class="scroll-down-wrap">
    <div class="mousey">
      <div class="scroller"></div>
    </div>
  </div>
  <i class="far fa-angle-down"></i>
</div>
