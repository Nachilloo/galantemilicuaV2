# ============================================================================
# .htaccess para dinahosting (Apache)
#
# Este archivo se copia tal cual desde public/ a dist/.htaccess durante
# `astro build`. Sube el contenido de dist/ al directorio raíz del hosting
# (típicamente `httpdocs/` o `public_html/`).
# ============================================================================

# --- 1. Redirects 301 (SEO) ------------------------------------------------
# Reemplazan los meta-refresh de Astro por redirects HTTP nativos.
# Mantener en sincronía con `astro.config.mjs > legacyRedirects`.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Portfolio singles
    RewriteRule ^portfolio-single\.html$          /portfolio/mobile-concepts-01              [R=301,L]
    RewriteRule ^portfolio-single01\.html$        /portfolio/mobile-concepts-02              [R=301,L]
    RewriteRule ^portfolio-single02\.html$        /portfolio/neumorphism-study               [R=301,L]
    RewriteRule ^portfolio-single03\.html$        /portfolio/ai-prompts-clients              [R=301,L]
    RewriteRule ^portfolio-single04\.html$        /portfolio/full-web-shop-concept           [R=301,L]
    RewriteRule ^portfolio-single05\.html$        /portfolio/wireframe-event-app             [R=301,L]
    RewriteRule ^portfolio-single06\.html$        /portfolio/3d-scroll                       [R=301,L]
    RewriteRule ^portfolio-single07\.html$        /portfolio/sitemap-event-app               [R=301,L]
    RewriteRule ^portfolio-single08\.html$        /portfolio/marketing-campaign-social       [R=301,L]
    RewriteRule ^portfolio-single09\.html$        /portfolio/full-web-shop                   [R=301,L]
    RewriteRule ^portfolio-single10\.html$        /portfolio/wireframe-event-app-manager     [R=301,L]
    RewriteRule ^portfolio-single11\.html$        /portfolio/project-manager-wordpress-plugin [R=301,L]
    RewriteRule ^portfolio-single12\.html$        /portfolio/surf-school-website             [R=301,L]
    RewriteRule ^portfolio-single13\.html$        /portfolio/motorbike-workshops-management  [R=301,L]
    RewriteRule ^portfolio-single14\.html$        /portfolio/ticket-seller-manager           [R=301,L]
    RewriteRule ^portfolio-single15\.html$        /portfolio/wordpress-real-estate-agency    [R=301,L]
    RewriteRule ^portfolio-single16\.html$        /portfolio/wordpress-heady-glass-art-gallery [R=301,L]

    # Páginas principales
    RewriteRule ^about\.html$                     /about                                     [R=301,L]
    RewriteRule ^contacts\.html$                  /contacts                                  [R=301,L]
    RewriteRule ^portfolio\.html$                 /portfolio                                 [R=301,L]

    # index.html → / (elimina duplicado SEO)
    RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
    RewriteRule ^index\.html$                     /                                          [R=301,L]

    # Fuerza HTTPS (dinahosting suele traerlo activado; comentar si aún no)
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # www → no-www (o al revés; deja este bloque comentado y activa el que
    # coincida con tu dominio canónico)
    # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# --- 2. Cache-Control para assets con hash --------------------------------
# Los archivos en /assets/ y /_astro/ tienen hash en el nombre; se pueden
# cachear indefinidamente. HTML no se cachea agresivamente.

<IfModule mod_headers.c>
    # 1 año para assets versionados (immutable)
    <FilesMatch "\.(css|js|woff2|woff|ttf|eot|svg|jpg|jpeg|png|webp|avif|gif|ico|mp4)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # HTML sin cache larga (revalidar siempre)
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>

    # Cabeceras de seguridad básicas
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- 3. Compresión gzip/brotli --------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- 4. MIME types para fuentes web ---------------------------------------
<IfModule mod_mime.c>
    AddType application/font-woff2 .woff2
    AddType application/font-woff  .woff
    AddType application/x-font-ttf .ttf
    AddType image/svg+xml          .svg
</IfModule>

# --- 5. Páginas de error ---------------------------------------------------
ErrorDocument 404 /404.html
